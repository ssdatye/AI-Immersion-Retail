<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Microsoft.Data.SqlClient does not support invariant globalization mode. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CostToServe.Core\CostToServe.Core.csproj" />
    <ProjectReference Include="..\CostToServe.Agent\CostToServe.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" />
    <PackageReference Include="Microsoft.Azure.Cosmos" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Playbook action settings ship with the app for Azure (CostToServe__ActionConfigFile=config/action-levers.csv). -->
    <None Include="..\..\data\config\action-levers.csv" Link="config\action-levers.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Latest evaluation summary for the Trust Center (CostToServe__EvalSummaryFile=trust/eval-summary.json). -->
    <None Include="..\..\docs\evals\summary.json" Link="trust\eval-summary.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\docs\evals\summary.json')" />
    <None Include="..\..\docs\architecture\cost-to-serve-architecture.html" Link="trust\architecture.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
