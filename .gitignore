.DS_Store
.idea/

# Generated local settings (endpoints from deployment outputs)
appsettings.Local.json

# Front-end build output (Vite builds into the API)
src/CostToServe.Api/wwwroot/

# Browser automation artifacts
.playwright-mcp/

# Evaluation run output (agent answers and tool results)
evals/out/
__pycache__/
